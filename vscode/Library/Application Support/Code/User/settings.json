{
  "workbench.colorTheme": "Min Dark",
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.8,
  "editor.rulers": [80, 120],
  "workbench.startupEditor": "newUntitledFile",
  "editor.renderLineHighlight": "gutter",

  "editor.minimap.enabled": false,
  "workbench.editor.labelFormat": "short",
  "explorer.compactFolders": false,
  "editor.semanticHighlighting.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.activityBar.location": "top",
  "editor.cursorStyle": "block-outline",
  "editor.cursorBlinking": "solid",
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.vertical": "auto",
  // "workbench.statusBar.visible": false,
  "window.commandCenter": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": ".eslint*, prettier*, tsconfig*, pnpm-lock*, package-lock.json, yarn.lock, pnpm-lock.yaml, .prettierrc, eslint.config.mjs, nest-cli.json, bun.lock, .gitignore",
    "vitest.config.ts": "vitest.config.e2e.ts",
    "tailwind.config*": "tailwind.*, tailwind.config*, postcss.config",
    ".env.local": ".env*",
    ".env": ".env*",
    "CLAUDE.md": "CLAUDE.md, ARCHITECTURE.md, .claude, CODE_REVIEW_*.md",
  },
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "JetBrains Mono Nerd Font",
  "editor.lineNumbers": "on",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "vim.useCtrlKeys": false,
  "git.autofetch": true,
  "workbench.sideBar.location": "right",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // bun.lock is JSONC with trailing commas by design; Bun rewrites it on every install
  "files.associations": {
    "bun.lock": "jsonc",
  },
  "json.schemas": [
    {
      "fileMatch": ["bun.lock"],
      "schema": { "allowTrailingCommas": true },
    },
  ],
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "editor.stickyScroll.enabled": true,
  "terminal.external.osxExec": "Ghostty.app",
  "github.copilot.editor.enableAutoCompletions": true,
  "workbench.colorCustomizations": {
    // "editor.background": "#00000021",
    // "editorStickyScroll.background": "#181818c0"
  },
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.inlineSuggest.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
  "github.copilot.nextEditSuggestions.enabled": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  "claudeCode.preferredLocation": "panel",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.experimental.useTsgo": true,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
  },
}
